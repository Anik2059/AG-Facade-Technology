# Copy this file to ".env" and fill in your details.
PORT=3000

# Where inquiries are emailed (your company inbox)
NOTIFY_EMAIL=agfacadetechnology06.bd@gmail.com

# SMTP login used to SEND the emails. For Gmail: turn on 2-Step Verification,
# then create an "App password" at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=agfacadetechnology06.bd@gmail.com
SMTP_PASS=your-16-letter-app-password

# Optional: also protect the admin inquiry list at /admin/inquiries?key=...
ADMIN_KEY=choose-a-long-random-secret

# ---- WhatsApp alerts (free, no email needed) ----
# 1) Save the CallMeBot number in your phone contacts (get the current number at
#    https://www.callmebot.com/blog/free-api-whatsapp-messages/ ).
# 2) Send it this WhatsApp message:  I allow callmebot to send me messages
# 3) It replies with your API key. Put your number (with country code) and key here.
#    Several people: separate with commas, same order.
WHATSAPP_PHONE=+8801XXXXXXXXX
WHATSAPP_APIKEY=
